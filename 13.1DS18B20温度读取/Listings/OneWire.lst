line level    source

   1          #include <REGX52.H>
   2          sbit OneWire_DQ=P3^7;
   3          
   4          unsigned char OneWire_Init(void)
   5          {
   6   1              unsigned char i;
   7   1              unsigned char AckBit;
   8   1              //1.进入初始化，先确保高电平再拉低
   9   1              OneWire_DQ=1;
  10   1              OneWire_DQ=0;
  11   1              //2.延时至少480us后再释放，留出多余一点时间，设为500ms
  12   1              i=247;while(--i);//延时500us
  13   1              //3.主机释放总线15~60us后，从机拉低60~240us（取70us检测从机拉低电平）
  14   1              OneWire_DQ=1;//主机释放
  15   1              i=32;while(--i);//延时70us检测
  16   1              AckBit=OneWire_DQ;//读取电平
  17   1              i=247;while(--i);//延时500ms，需要保证第二个时间片>480us
  18   1              return AckBit;
  19   1      }
  20          
  21          void OneWire_SendBit(unsigned char Bit)
  22          {
  23   1              unsigned char i;
  24   1              //1.主机先拉低60~120us后释放表示发送0；拉低1~15us后释放表示发送1
  25   1              OneWire_DQ=0;
  26   1              i=4;while(--i);//延时10us（实际14）
  27   1              OneWire_DQ=Bit;
  28   1              i=24;while(--i);//延时50us（实际54）
  29   1              OneWire_DQ=1;//主机释放
  30   1              //如果Bit=0则14us后为低电平，Bit为1则14us后释放为高电平
  31   1      }
  32          
  33          unsigned char OneWire_ReceiveBit(void)
  34          {
  35   1              unsigned char i;
  36   1              unsigned char Bit;
  37   1              //主机先拉低1~15us释放并在15us读取高低电平
  38   1              OneWire_DQ=0;
  39   1              i=2;while(--i);//延时5us
  40   1              OneWire_DQ=1;
  41   1              i=2;while(--i);//延时5us
  42   1              Bit=OneWire_DQ;//采样
  43   1              i=24;while(--i);//延时50us
  44   1              return Bit;
  45   1      }
  46          //发送1个字节
  47          void OneWire_SendByte(unsigned char Byte)
  48          {
  49   1              unsigned char i;
  50   1              for(i=0;i<8;i++)
  51   1              {
  52   2                      OneWire_SendBit(Byte&(0x01<<i));
  53   2              }
  54   1      }
C51 COMPILER V9.54   ONEWIRE                                                               07/31/2026 21:26:28 PAGE 2   

  55          //接收1个字节
  56          unsigned char OneWire_ReceiveByte(void)
  57          {
  58   1              unsigned char i;
  59   1              unsigned char Byte=0x00;
  60   1              for(i=0;i<8;i++)
  61   1              {
  62   2                      if(OneWire_ReceiveBit()){Byte|=(0x01<<i);}
  63   2              }
  64   1              return Byte;
  65   1      }


