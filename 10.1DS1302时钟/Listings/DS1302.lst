line level    source

   1          #include <REGX52.H>
   2          sbit DS1302_SCLK=P3^6;
   3          sbit DS1302_IO=P3^4;
   4          sbit DS1302_CE=P3^5;
   5          
   6          #define DS1302_SECOND 0x80
   7          #define DS1302_MINUTE 0x82
   8          #define DS1302_HOUR 0x84
   9          #define DS1302_DATE 0x86
  10          #define DS1302_MONTH 0x88
  11          #define DS1302_DAY 0x8A
  12          #define DS1302_YEAR 0x8C
  13          #define DS1302_WP 0x8E
  14          unsigned char DS1302_Time[]={26,7,27,11,33,20,6};
  15          
  16          void DS1302_Init(void)
  17          {
  18   1              //由时序图知，CE和SCLK读写前默认低电平，即先置0
  19   1              DS1302_CE=0;
  20   1              DS1302_SCLK=0;
  21   1      }
  22          void DS1302_WriteByte(unsigned char Command,Data)
  23          {
  24   1              unsigned char i;
  25   1              //1.CE先置1
  26   1              DS1302_CE=1;
  27   1              for(i=0;i<8;i++)
  28   1              {
  29   2                      //2.先把命令字放在IO口上，先读取最0位,依次移位
  30   2                      DS1302_IO=Command&(0x01<<i);
  31   2                      //3.上升沿，锁存该位数据
  32   2                      DS1302_SCLK=1;
  33   2                      //4.时钟复位准备下一位
  34   2                      DS1302_SCLK=0;//如果过快需要延时，稳定一段高电平
  35   2              }
  36   1              for(i=0;i<8;i++)
  37   1              {
  38   2                      DS1302_IO=Data&(0x01<<i);
  39   2                      DS1302_SCLK=1;
  40   2                      DS1302_SCLK=0;
  41   2              }
  42   1              DS1302_CE=0;
  43   1      }
  44          unsigned char DS1302_ReadByte(unsigned char Command)
  45          {
  46   1              unsigned char i,Data=0x00;//局部变量默认初始化值不一定为0
  47   1              Command|=0x01;
  48   1              DS1302_CE=1;
  49   1              for(i=0;i<8;i++)
  50   1              {
  51   2                      DS1302_IO=Command&(0x01<<i);
  52   2                      DS1302_SCLK=0;//先0后1作周期
  53   2                      DS1302_SCLK=1;
  54   2              }       
C51 COMPILER V9.54   DS1302                                                                07/27/2026 15:14:42 PAGE 2   

  55   1              
  56   1              for(i=0;i<8;i++)
  57   1              {
  58   2                      DS1302_SCLK=1;
  59   2                      DS1302_SCLK=0;//补1上升沿让D0被推到IO线上，才能继续采集
  60   2                      if(DS1302_IO)//赋值时单片机输出，不赋值if时由DS1302控制,IO值和读取到的bit值相同
  61   2                              {Data|=(0x01<<i);}//只对最后一位操作，读取到最低位为1则更新并移位，最低位为0
             -则不更新数据而直接左移1位
  62   2              }
  63   1              DS1302_CE=0;
  64   1              DS1302_IO=0;
  65   1              return Data;
  66   1      }
  67          void DS1302_SetTime(void)
  68          {
  69   1              DS1302_WriteByte(DS1302_WP,0x00);//关闭写保护
  70   1              DS1302_WriteByte(DS1302_YEAR,DS1302_Time[0]/10*16+DS1302_Time[0]%10);
  71   1              DS1302_WriteByte(DS1302_MONTH,DS1302_Time[1]/10*16+DS1302_Time[1]%10);
  72   1              DS1302_WriteByte(DS1302_DATE,DS1302_Time[2]/10*16+DS1302_Time[2]%10);
  73   1              DS1302_WriteByte(DS1302_HOUR,DS1302_Time[3]/10*16+DS1302_Time[3]%10);
  74   1              DS1302_WriteByte(DS1302_MINUTE,DS1302_Time[4]/10*16+DS1302_Time[4]%10);
  75   1              DS1302_WriteByte(DS1302_SECOND,DS1302_Time[5]/10*16+DS1302_Time[5]%10);
  76   1              DS1302_WriteByte(DS1302_DAY,DS1302_Time[6]/10*16+DS1302_Time[6]%10);
  77   1              DS1302_WriteByte(DS1302_WP,0x80);//打开写保护
  78   1      }
  79          void DS1302_ReadTime(void)
  80          {
  81   1              unsigned char Temp;
  82   1              Temp=DS1302_ReadByte(DS1302_YEAR);
  83   1              DS1302_Time[0]=Temp/16*10+Temp%16;
  84   1              Temp=DS1302_ReadByte(DS1302_MONTH);
  85   1              DS1302_Time[1]=Temp/16*10+Temp%16;
  86   1              Temp=DS1302_ReadByte(DS1302_DATE);
  87   1              DS1302_Time[2]=Temp/16*10+Temp%16;
  88   1              Temp=DS1302_ReadByte(DS1302_HOUR);
  89   1              DS1302_Time[3]=Temp/16*10+Temp%16;
  90   1              Temp=DS1302_ReadByte(DS1302_MINUTE);
  91   1              DS1302_Time[4]=Temp/16*10+Temp%16;
  92   1              Temp=DS1302_ReadByte(DS1302_SECOND);
  93   1              DS1302_Time[5]=Temp/16*10+Temp%16;
  94   1              Temp=DS1302_ReadByte(DS1302_DAY);
  95   1              DS1302_Time[6]=Temp/16*10+Temp%16;
  96   1      }


