  48   2                      /*阈值温度判断及显示*/
  49   2                      if(KeyNum)
  50   2                      {
  51   3                              if(KeyNum==1)
  52   3                              {       THigh++;
  53   4                                      if(THigh>125){THigh=125;}
  54   4                              }
