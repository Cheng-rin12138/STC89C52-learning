   3          
   4          unsigned char OneWire_Init(void)
   5          {
   6   1              unsigned char i;
   7   1              unsigned char AckBit;
   8   1              EA=0;
   9   1              //1.进入初始化，先确保高电平再拉低
  10   1              OneWire_DQ=1;
  11   1              OneWire_DQ=0;
  12   1              //2.延时至少480us后再释放，留出多余一点时间，设为500ms
  13   1              i=247;while(--i);//延时500us
  14   1              //3.主机释放总线15~60us后，从机拉低60~240us（取70us检测从机拉低电平）
  15   1              OneWire_DQ=1;//主机释放
  16   1              i=32;while(--i);//延时70us检测
  17   1              AckBit=OneWire_DQ;//读取电平
  18   1              i=247;while(--i);//延时500ms，需要保证第二个时间片>480us
  19   1              EA=1;
  20   1              return AckBit;
  21   1      }
  22          
  23          void OneWire_SendBit(unsigned char Bit)
  24          {
  25   1              unsigned char i;
  26   1              EA=0;
  27   1              //1.主机先拉低60~120us后释放表示发送0；拉低1~15us后释放表示发送1
  28   1              OneWire_DQ=0;
  29   1              i=4;while(--i);//延时10us（实际14）
  30   1              OneWire_DQ=Bit;
  31   1              i=24;while(--i);//延时50us（实际54）
  32   1              OneWire_DQ=1;//主机释放
  33   1              //如果Bit=0则14us后为低电平，Bit为1则14us后释放为高电平
  34   1              EA=1;
  35   1      }
  36          
  37          unsigned char OneWire_ReceiveBit(void)
  38          {
  39   1              unsigned char i;
  40   1              unsigned char Bit;
  41   1              EA=0;
  42   1              //主机先拉低1~15us释放并在15us读取高低电平
  43   1              OneWire_DQ=0;
  44   1              i=2;while(--i);//延时5us
  45   1              OneWire_DQ=1;
  46   1              i=2;while(--i);//延时5us
  47   1              Bit=OneWire_DQ;//采样
  48   1              i=24;while(--i);//延时50us
  49   1              EA=1;
  50   1              return Bit;
  51   1      }
  52          //发送1个字节
  53          void OneWire_SendByte(unsigned char Byte)
  54          {
C51 COMPILER V9.54   ONEWIRE                                                               08/01/2026 12:24:12 PAGE 2   

  55   1              unsigned char i;
